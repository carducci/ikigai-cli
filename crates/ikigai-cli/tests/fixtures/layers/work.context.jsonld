{ "@context": {
  "ik": "https://ikigai-rs.dev/ns#",
  "dcterms": "http://purl.org/dc/terms/",
  "prov": "http://www.w3.org/ns/prov#",
  "xsd": "http://www.w3.org/2001/XMLSchema#",
  "Message": "ik:Message",
  "Question": "ik:Question",
  "Brief": "ik:Brief",
  "Issue": "ik:Issue",
  "File": "ik:File",
  "title": "dcterms:title",
  "body": "ik:body",
  "repository": { "@id": "ik:repository", "@type": "@id" },
  "severity": { "@id": "ik:severity", "@type": "@id" },
  "fileName": "ik:fileName",
  "mediaType": "ik:mediaType",
  "contentHash": "ik:contentHash",
  "byteSize": { "@id": "ik:byteSize", "@type": "xsd:integer" },
  "encoding": "ik:encoding",
  "content": "ik:content",
  "inReplyTo": { "@id": "ik:inReplyTo", "@type": "@id" },
  "supersedes": { "@id": "ik:supersedes", "@type": "@id" },
  "attributedTo": { "@id": "prov:wasAttributedTo", "@type": "@id" },
  "created": { "@id": "dcterms:created", "@type": "xsd:dateTime" },
  "seq": { "@id": "ik:seq", "@type": "xsd:integer" }
} }
